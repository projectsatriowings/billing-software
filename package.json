{
  "name": "billing-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Configurable, India-first billing platform: React + Node.js + Neon Postgres",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-client.mjs",
    "start": "node --import tsx server/src/index.ts",
    "migrate": "node --import tsx server/src/migrate.ts",
    "seed:demo": "node --import tsx server/src/seed-demo.ts",
    "test": "node --import tsx --test --test-concurrency=1 \"shared/test/*.test.ts\" \"server/test/*.test.ts\"",
    "backup": "node scripts/backup-db.mjs",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p client/tsconfig.json"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
