# Copy this file to ".env" and fill it in. Never commit ".env" and never paste real secrets in chat.

# Neon: open your project > Connect > copy the POOLED connection string (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-your-endpoint-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Long random text used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3000
# Login stays valid for this many seconds (default 7 days)
# JWT_TTL_SECONDS=604800

# Public address of your site, used inside WhatsApp bill links (leave empty in local development)
# PUBLIC_URL=https://your-shop-app.example.com

# Optional: WhatsApp Business Cloud API. Leave empty to use the free click-to-chat links.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE=
# WHATSAPP_TEMPLATE_LANG=en
